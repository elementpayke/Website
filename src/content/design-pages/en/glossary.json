  {
   "@context": "https://schema.org",
   "@graph": [
    {
     "@type": "DefinedTermSet",
     "name": "ElementPay payments glossary",
     "url": "https://www.elementpay.net/glossary",
     "hasDefinedTerm": [
      {
       "@type": "DefinedTerm",
       "name": "ACH",
       "description": "Automated Clearing House: the US network for batch electronic bank transfers, used for payroll, bills and business payments in USD.",
       "url": "https://www.elementpay.net/glossary#ach"
      },
      {
       "@type": "DefinedTerm",
       "name": "BCEAO",
       "description": "Central Bank of West African States. It issues the West African CFA franc (XOF) for eight WAEMU countries.",
       "url": "https://www.elementpay.net/glossary#bceao"
      },
      {
       "@type": "DefinedTerm",
       "name": "BEAC",
       "description": "Bank of Central African States. It issues the Central African CFA franc (XAF) for six CEMAC countries.",
       "url": "https://www.elementpay.net/glossary#beac"
      },
      {
       "@type": "DefinedTerm",
       "name": "CFA franc (XOF and XAF)",
       "description": "Two separate currencies, the West African CFA franc (XOF) and the Central African CFA franc (XAF), each pegged to the euro at 655.957 francs per euro. They are not interchangeable.",
       "url": "https://www.elementpay.net/glossary#cfa-franc"
      },
      {
       "@type": "DefinedTerm",
       "name": "Collection",
       "description": "Receiving a payment from a customer or partner, for example by mobile money, bank transfer or a payment link.",
       "url": "https://www.elementpay.net/glossary#collection"
      },
      {
       "@type": "DefinedTerm",
       "name": "Correspondent bank",
       "description": "A bank that holds accounts for other banks and processes payments on their behalf, often in a foreign currency. International wires may pass through one or more correspondents.",
       "url": "https://www.elementpay.net/glossary#correspondent-bank"
      },
      {
       "@type": "DefinedTerm",
       "name": "De-risking",
       "description": "When banks end relationships with clients or regions they consider high risk, rather than managing that risk. It has reduced correspondent banking links with many smaller markets.",
       "url": "https://www.elementpay.net/glossary#de-risking"
      },
      {
       "@type": "DefinedTerm",
       "name": "EFT",
       "description": "Electronic funds transfer. In South Africa, EFT is the standard way to pay into a bank account.",
       "url": "https://www.elementpay.net/glossary#eft"
      },
      {
       "@type": "DefinedTerm",
       "name": "Faster Payments",
       "description": "The UK real-time payment scheme for GBP transfers between bank accounts, available 24/7.",
       "url": "https://www.elementpay.net/glossary#faster-payments"
      },
      {
       "@type": "DefinedTerm",
       "name": "IBAN",
       "description": "International Bank Account Number: a standard format that identifies a bank account across borders, used throughout Europe and in many other countries.",
       "url": "https://www.elementpay.net/glossary#iban"
      },
      {
       "@type": "DefinedTerm",
       "name": "KYB",
       "description": "Know your business: verifying a company’s registration, directors, beneficial owners and activities before it can use a financial service.",
       "url": "https://www.elementpay.net/glossary#kyb"
      },
      {
       "@type": "DefinedTerm",
       "name": "Mid-market rate",
       "description": "The midpoint between the buy and sell prices of two currencies on global markets. Providers add a margin or fee on top.",
       "url": "https://www.elementpay.net/glossary#mid-market-rate"
      },
      {
       "@type": "DefinedTerm",
       "name": "Mobile money",
       "description": "A store of value linked to a mobile phone number, run by a telecom operator or licensed provider, used to pay, send and receive money without a bank account.",
       "url": "https://www.elementpay.net/glossary#mobile-money"
      },
      {
       "@type": "DefinedTerm",
       "name": "M-Pesa",
       "description": "The mobile money service launched by Safaricom in Kenya in 2007. Vodacom also runs M-Pesa in Tanzania, DR Congo and Mozambique.",
       "url": "https://www.elementpay.net/glossary#m-pesa"
      },
      {
       "@type": "DefinedTerm",
       "name": "MTN MoMo",
       "description": "MTN Group’s mobile money service, used in Uganda, Ghana, Rwanda, Cameroon, Côte d’Ivoire, Benin, Zambia and other markets.",
       "url": "https://www.elementpay.net/glossary#mtn-momo"
      },
      {
       "@type": "DefinedTerm",
       "name": "Nostro account",
       "description": "An account a bank holds in a foreign currency at another bank, used to send and receive payments in that currency. Pre-funding nostro accounts ties up capital.",
       "url": "https://www.elementpay.net/glossary#nostro-account"
      },
      {
       "@type": "DefinedTerm",
       "name": "Off-ramp",
       "description": "Converting digital assets such as USDC or USDT into local currency, ideally paid straight to a bank account or mobile money wallet.",
       "url": "https://www.elementpay.net/glossary#off-ramp"
      },
      {
       "@type": "DefinedTerm",
       "name": "On-ramp",
       "description": "Converting local currency into digital assets such as USDC or USDT.",
       "url": "https://www.elementpay.net/glossary#on-ramp"
      },
      {
       "@type": "DefinedTerm",
       "name": "OTC desk",
       "description": "An over-the-counter desk where a trader quotes large currency or stablecoin trades directly, instead of executing on a public order book.",
       "url": "https://www.elementpay.net/glossary#otc-desk"
      },
      {
       "@type": "DefinedTerm",
       "name": "Paybill and Till numbers",
       "description": "M-Pesa business numbers in Kenya. Paybill is used for bill and account payments; Till (Buy Goods) is used for purchases from merchants.",
       "url": "https://www.elementpay.net/glossary#paybill-and-till-numbers"
      },
      {
       "@type": "DefinedTerm",
       "name": "PesaLink",
       "description": "A real-time interbank transfer service in Kenya that lets customers send money between participating banks.",
       "url": "https://www.elementpay.net/glossary#pesalink"
      },
      {
       "@type": "DefinedTerm",
       "name": "Payout",
       "description": "Sending money from your balance to a recipient, such as a supplier, employee or customer, on their mobile money wallet or bank account.",
       "url": "https://www.elementpay.net/glossary#payout"
      },
      {
       "@type": "DefinedTerm",
       "name": "Rate lock",
       "description": "Holding an exchange rate quote for a fixed period so the amount the recipient gets does not change while you approve.",
       "url": "https://www.elementpay.net/glossary#rate-lock"
      },
      {
       "@type": "DefinedTerm",
       "name": "SEPA",
       "description": "Single Euro Payments Area: the scheme for euro bank transfers across the EU and other European countries. SEPA Instant settles in seconds.",
       "url": "https://www.elementpay.net/glossary#sepa"
      },
      {
       "@type": "DefinedTerm",
       "name": "Settlement",
       "description": "The point at which funds actually move and a payment becomes final.",
       "url": "https://www.elementpay.net/glossary#settlement"
      },
      {
       "@type": "DefinedTerm",
       "name": "Sort code",
       "description": "A six-digit number that identifies a UK bank branch. Used with an account number for GBP payments.",
       "url": "https://www.elementpay.net/glossary#sort-code"
      },
      {
       "@type": "DefinedTerm",
       "name": "Stablecoin",
       "description": "A digital token designed to hold a stable value, usually one-to-one with a currency such as the US dollar. USDC and USDT are the most widely used.",
       "url": "https://www.elementpay.net/glossary#stablecoin"
      },
      {
       "@type": "DefinedTerm",
       "name": "SWIFT",
       "description": "The messaging network banks use to send international payment instructions. A SWIFT payment often relies on correspondent banks to move the funds.",
       "url": "https://www.elementpay.net/glossary#swift"
      },
      {
       "@type": "DefinedTerm",
       "name": "USDC",
       "description": "A US dollar stablecoin issued by Circle.",
       "url": "https://www.elementpay.net/glossary#usdc"
      },
      {
       "@type": "DefinedTerm",
       "name": "USDT",
       "description": "A US dollar stablecoin issued by Tether.",
       "url": "https://www.elementpay.net/glossary#usdt"
      },
      {
       "@type": "DefinedTerm",
       "name": "Wave",
       "description": "A mobile money service operating in Senegal, Côte d’Ivoire and other West African countries.",
       "url": "https://www.elementpay.net/glossary#wave"
      },
      {
       "@type": "DefinedTerm",
       "name": "Webhook",
       "description": "A message a platform sends to your server when an event happens, such as a payout being settled.",
       "url": "https://www.elementpay.net/glossary#webhook"
      }
     ]
    },
    {
