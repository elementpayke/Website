# Email delivery for the /contact and /careers forms (src/app/api/contact, src/app/api/careers).
# Sent via SendGrid's Web API (https://api.sendgrid.com/v3/mail/send) — no SDK required.

# SendGrid API key with Mail Send permission.
SENDGRID_API_KEY=

# A sender identity verified in SendGrid (Settings > Sender Authentication).
SENDGRID_FROM_EMAIL=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# Inbox that receives careers applications. Falls back to CONTACT_TO_EMAIL if unset.
CAREERS_TO_EMAIL=
