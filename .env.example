# Email delivery for the /contact and /careers forms.
# Set EMAIL_PROVIDER to "sendgrid" or "brevo" when both providers are configured.
# If omitted, the provider is inferred from the single API key that is configured.
EMAIL_PROVIDER=

# SendGrid (https://api.sendgrid.com/v3/mail/send)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Brevo (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# Inbox that receives careers applications. Falls back to CONTACT_TO_EMAIL if unset.
CAREERS_TO_EMAIL=
